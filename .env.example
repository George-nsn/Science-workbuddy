# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Local-only web/API addresses
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# Server-side URL used only when the Web process runs in a container.
API_INTERNAL_URL=http://api:8000/api/v1
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# SQLite durable store and Redis queue/L2 cache
DATABASE_URL=sqlite+aiosqlite:///data/science_buddy.db
REDIS_URL=redis://redis:6379/0

# Retrieval defaults
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768
MAX_REFINEMENT_ROUNDS=2
RETRIEVAL_VERSION=hybrid-v2
RETRIEVAL_RRF_K=60
RETRIEVAL_WEIGHT_EXACT=1.5
RETRIEVAL_WEIGHT_SIMPLE=1.1
RETRIEVAL_WEIGHT_DENSE_ORIGINAL=1.0
RETRIEVAL_WEIGHT_FTS_ENGLISH=0.9
RETRIEVAL_WEIGHT_DENSE_TRANSLATED=0.8
RETRIEVAL_WEIGHT_METADATA=0.8
RETRIEVAL_WEIGHT_MESH=0.8
RETRIEVAL_WEIGHT_GRAPH=0.3
RETRIEVAL_WEIGHT_GRAPH_GLOBAL=0.15
RETRIEVAL_WEIGHT_GRAPH_DRIFT=0.2
RETRIEVAL_WEIGHT_GRAPH_PATH=0.15
RETRIEVAL_TOP_K_DENSE=50
RETRIEVAL_TOP_K_FTS=50
RETRIEVAL_TOP_K_SIMPLE=30
RETRIEVAL_TOP_K_METADATA=30
RETRIEVAL_FUSED_POOL=40
RETRIEVAL_MAX_CHUNKS_PER_PAPER=3
RETRIEVAL_CONTEXT_RADIUS=1
RETRIEVAL_CONTEXT_MAX_CHARS=16000
RETRIEVAL_ROUTE_TIMEOUT_SECONDS=5
RETRIEVAL_DENSE_ROUTE_TIMEOUT_SECONDS=30
RETRIEVAL_GRAPH_SEED_PAPERS=8
RETRIEVAL_GRAPH_NEIGHBORS=8
RETRIEVAL_GRAPH_COMMUNITY_TOP_K=5
RETRIEVAL_GRAPH_PATH_TOP_K=3
RETRIEVAL_VECTOR_BACKEND=numpy
RETRIEVAL_SUBQUERY_PARALLELISM=1
RETRIEVAL_RERANKER_ENABLED=false
RETRIEVAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_RERANKER_CANDIDATES=30
RETRIEVAL_RERANKER_WEIGHT=0.65
# Best-effort hard timeout for the optional local reranker; on timeout the
# fused RRF order is used unchanged and the report records "reranker_timeout".
RETRIEVAL_RERANKER_TIMEOUT_SECONDS=30
# Enrich zh/mixed queries with the project's own MeSH terminology (grounded
# expansion only: labels must lexically overlap the translated query).
RETRIEVAL_QUERY_MESH_EXPANSION=true
RETRIEVAL_QUERY_MESH_MAX_TERMS=4
RETRIEVAL_RERANKER_CANDIDATES=30
RETRIEVAL_RERANKER_WEIGHT=0.65
CACHE_NAMESPACE=science-buddy
CACHE_L1_MAX_ENTRIES=256
CACHE_L1_TTL_SECONDS=300
CACHE_L2_TTL_SECONDS=3600
CACHE_L3_TTL_SECONDS=86400

# Literature providers. NCBI recommends a registered tool/email and enforces
# 3 requests/second without a key, 10 requests/second with a key.
NCBI_TOOL=science_buddy
NCBI_EMAIL=
NCBI_API_KEY=
NCBI_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
EUROPE_PMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
LITERATURE_REQUEST_TIMEOUT_SECONDS=20
DEFAULT_PROJECT_NAME=My Research Library
EVIDENCE_SIGNING_KEY=replace-with-at-least-16-random-characters
# Optional dedicated secret for encrypting a model API Key saved through the local UI.
# If omitted, EVIDENCE_SIGNING_KEY is used. Changing it requires entering the API Key again.
MODEL_CONFIG_ENCRYPTION_KEY=
UPLOAD_DIRECTORY=data/uploads
MAX_UPLOAD_BYTES=26214400

# Optional model override. Supported preset IDs include openai, anthropic,
# deepseek, google_gemini, qwen, kimi, zhipu, siliconflow, openrouter,
# ollama, lmstudio, and openai_compatible. Complete environment configuration
# overrides the encrypted local UI setting. Ollama/LM Studio may omit the Key.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
